# Backend origin. Leave EMPTY in dev so requests go through the Vite proxy
# (config/session.php pins same_site='lax', so cross-site dev would drop the cookie).
VITE_API_ORIGIN=

# Laravel route prefix — RouteServiceProvider.php:33 -> ->prefix('api')
VITE_API_PREFIX=/api/

# Dev only: where the Vite proxy forwards /api and /sanctum.
VITE_DEV_BACKEND_ORIGIN=https://panel.example.com

# Production instead:
# VITE_API_ORIGIN=https://panel.rentafacilrd.com
# VITE_API_PREFIX=/api/
