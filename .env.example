# Backend origin. Leave EMPTY in dev so requests go through the Vite proxy
# (config/session.php pins same_site='lax', so cross-site dev would drop the cookie).
VITE_API_ORIGIN=

# Laravel route prefix — RouteServiceProvider.php:33 -> ->prefix('api')
VITE_API_PREFIX=/api/

# Dev only: where the Vite proxy forwards /api and /sanctum.
VITE_DEV_BACKEND_ORIGIN=https://panel.example.com

# Production instead:
# VITE_API_ORIGIN=https://panel.rentafacilrd.com
# VITE_API_PREFIX=/api/

# Google Maps JS key — address autocomplete on the listing wizard.
# Vite inlines it at BUILD time, so it must be set before `pnpm build` runs;
# adding it to the host and restarting will NOT put it in the bundle.
# It is public by design (Maps JS has no server side), so restrict the key in
# Google Cloud Console: HTTP referrers -> https://crm.rentafacilrd.com/*, and
# API restrictions -> Maps JavaScript API + Places API.
# Leave empty to ship without autocomplete: the address stays a plain field and
# the map pin still sets the coordinates.
VITE_GOOGLE_MAPS_API_KEY=
